[node name="CellHighlight" type="MeshInstance3D" parent="."]
editor_description = "Aim feedback only (01-06) - purely local presentation, driven every frame by Carrier._process from the local player's own aim query and never replicated: no @rpc, no MultiplayerSynchronizer touches this node, even though it sits on a Rack every peer can see. resource_local_to_scene=true on the material is what lets two racks each own their own colour without one rack's highlight recolouring the other's."
visible = false
mesh = SubResource("BoxMesh_highlight")
material_override = SubResource("StandardMaterial3D_highlight")

[node name="Frame" type="Node3D" parent="."]
editor_description = "Greybox only - exact dimensions matter more than looks (ADR 18 / art pipeline). Three decks at y=0/1/2 plus four corner uprights, all use_collision=true on the default layer 1 (world), so cargo rests on the decks and players walk into the frame like any other level geometry."

