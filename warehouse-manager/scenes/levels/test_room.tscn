[node name="PersonnelGap" type="Marker3D" parent="Geometry"]
editor_description = "No door here, deliberately (ADR 25 (f)): a permanent, doorless opening is the simplest possible implementation of \"a player is never locked in or out\" — the roller door (DockDoor, north wall) governs commerce, not this gap. Do not fill this in; it looks like an unfinished wall, and it is load-bearing."
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -10.25, 1, 0)

