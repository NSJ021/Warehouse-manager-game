[node name="WallWest_South" type="CSGBox3D" parent="Geometry"]
editor_description = "Split from a single WallWest (02-03) to leave a permanent, doorless 2.0 m personnel gap at z=0 — ADR 25 (f)'s \"players always have a side way through\", answered with the simplest possible implementation: a hole. See PersonnelGap below. Clear of every integration-suite corridor: crate rows sit at x=[-2.5,2.5], racks at x=6.5, both zones at x=-7 (not near the west wall at x=-10.25 at all)."
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -10.25, 2, -5.5)
use_collision = true
size = Vector3(0.5, 4, 9.0)
material = SubResource("StandardMaterial3D_wall")

