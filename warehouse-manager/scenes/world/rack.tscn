[node name="CellSensors" type="Node3D" parent="."]
editor_description = "The aim target, one CellSensor Area3D per cell rather than one covering the whole rack - a single hull would only ever return the front surface to a raycast, which would make a buried back-row cell unaimable even from the far side of an island rack. collision_layer=8 (storage), collision_mask=0, monitoring and monitorable both OFF: hittability by a raycast is independent of both flags (test/api/engine_assumptions.gd), so a rack full of these costs nothing in collision detection."

[node name="CellSensor0" type="Area3D" parent="CellSensors"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.5, 0.5, 0.5)
collision_layer = 8
collision_mask = 0
monitoring = false
monitorable = false

