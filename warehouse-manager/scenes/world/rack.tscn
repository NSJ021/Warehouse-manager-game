[node name="ImpactSensor" type="Area3D" parent="."]
editor_description = "01-07's shed trigger. Centred on the rack's own footprint (x=1.0, z=1.0 - the width and depth midpoints) at y=1.3, the height band a carried crate actually rides at (Crate.hold_reach/hold_drop put a held crate's centre a little below eye height), so a crate carried or thrown into the frame is caught in the act rather than after the frame's own CSG collision has already resolved the hit and robbed it of speed. collision_layer=0, collision_mask=4 (cargo) - this also catches a HELD crate, deliberately: carrying one hard into a rack is exactly the recklessness this system exists to punish (Rack._on_impact). monitorable=false: nothing needs to detect this sensor, only the reverse. Host-only in practice - Rack._ready() turns monitoring off and connects nothing on a client, the same host/client split Crate.gd's own PushSensor uses, so a client never pays for detection it never reads."
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.0, 1.3, 1.0)
collision_layer = 0
collision_mask = 4
monitorable = false
monitoring = true

[node name="ImpactSensorShape" type="CollisionShape3D" parent="ImpactSensor"]
shape = SubResource("BoxShape3D_impact")
